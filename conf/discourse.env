# Discourse global settings overriding config/global_settings.yml, loaded by systemd and the install scripts
DISCOURSE_DB_NAME=__DB_NAME__
DISCOURSE_DB_USERNAME=__DB_USER__
DISCOURSE_DB_PASSWORD=__DB_PWD__
DISCOURSE_DB_BACKUP_PORT=5432
DISCOURSE_HOSTNAME=__DOMAIN__
DISCOURSE_RELATIVE_URL_ROOT=__RELATIVE_URL_ROOT__
DISCOURSE_SMTP_ADDRESS=localhost
DISCOURSE_SMTP_DOMAIN=__DOMAIN__
DISCOURSE_SMTP_ENABLE_START_TLS=false
DISCOURSE_LOAD_MINI_PROFILER=false
DISCOURSE_DEVELOPER_EMAILS=__ADMIN_MAIL__
DISCOURSE_REDIS_DB=__REDIS_DB__
DISCOURSE_SERVE_STATIC_ASSETS=true
DISCOURSE_MAX_USER_API_REQS_PER_MINUTE=20
DISCOURSE_MAX_USER_API_REQS_PER_DAY=2880
DISCOURSE_ENABLE_VIPS_IMAGE_PROCESSING=false
